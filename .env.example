# Configuración de la entrega local de ProfeLink.
# Copiar a .env para el repositorio de infraestructura independiente.
# Las credenciales de producción nunca deben ir aquí.

# Imágenes públicas de tu cuenta; Published es el modo predeterminado.
# Etiquetas versionadas para reproducibilidad; ambas tienen también latest.
PROFELINK_API_IMAGE=keril777/profelink-api:local-20261111-a28e5dd
PROFELINK_WEB_IMAGE=keril777/profelink-web:local-20261111-38b014f

# PostgreSQL existente en Docker: NO crear otro contenedor ni volumen.
PROFELINK_PG_CONTAINER=profelink-pg-test-answers
PROFELINK_PG_NETWORK=profelink-data
# Red externa: el script conecta la BD existente; Compose no la crea ni la borra.
# Ejemplo de formato, SIN credenciales reales:
# postgresql://USUARIO:CONTRASENA@profelink-pg-test-answers:5432/NOMBRE_BD
# Si se deja vacío, el script deriva usuario/base de TEST_DATABASE_URL del backend.
PROFELINK_DOCKER_DATABASE_URL=

# Solo para el modo Local: clones hermanos; no necesarios en modo Published.
BACKEND_CONTEXT=../Back-Proyecto2
FRONTEND_CONTEXT=../kahoot_front_grupo2

# Supabase Auth/Storage (solo claves de un proyecto de prueba).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=question-images

# Frontend y CORS.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCKS=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8080

# Opcionales.
PORT=3000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
OTEL_SERVICE_NAME=profelink-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
